\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces IS ablation on no-centering cells. Solid: IS on. Dashed: IS off. Red: exact KL (cell B). Blue: approx KL (cell D).}}{6}{figure.7}\protected@file@percent }
