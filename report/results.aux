\@writefile{toc}{\contentsline {section}{\tocsection {}{2}{$2\times 2$ matrix: EMA reference}}{1}{section.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Eval accuracy on Countdown for the four cells of the EMA-reference matrix. Red: exact KL. Blue: approx KL. Solid: K-centered. Dashed: no centering. The two no-centering cells (dashed) plateau above $0.80$ and peak above $0.82$; the two K-centered cells (solid) peak earlier and degrade after step $\approx 300$.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:matrix}{{1}{2}{Eval accuracy on Countdown for the four cells of the EMA-reference matrix. Red: exact KL. Blue: approx KL. Solid: K-centered. Dashed: no centering. The two no-centering cells (dashed) plateau above $0.80$ and peak above $0.82$; the two K-centered cells (solid) peak earlier and degrade after step $\approx 300$}{figure.1}{}}
\@writefile{toc}{\contentsline {section}{\tocsection {}{3}{Reset reference (baseline)}}{2}{section.3}\protected@file@percent }
\newlabel{eq:reset-persample}{{2}{2}{Reset reference (baseline)}{equation.3.2}{}}
\newlabel{eq:reset-kmean}{{3}{2}{Reset reference (baseline)}{equation.3.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Eval accuracy on Countdown with periodic-reset reference and importance sampling on. $T/T$ (red) collapses late in training; $I/I$ (green) is unstable; only $T/I$ (blue) trains stably to high accuracy.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:reset-is}{{2}{3}{Eval accuracy on Countdown with periodic-reset reference and importance sampling on. $T/T$ (red) collapses late in training; $I/I$ (green) is unstable; only $T/I$ (blue) trains stably to high accuracy}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Eval accuracy on Countdown with periodic-reset reference and importance sampling off. The same ordering holds — $T/I$ best, $T/T$ collapses, $I/I$ gets stuck near zero — and all three are weaker than their IS-on counterparts.}}{3}{figure.3}\protected@file@percent }
\newlabel{fig:reset-nois}{{3}{3}{Eval accuracy on Countdown with periodic-reset reference and importance sampling off. The same ordering holds — $T/I$ best, $T/T$ collapses, $I/I$ gets stuck near zero — and all three are weaker than their IS-on counterparts}{figure.3}{}}
\@writefile{toc}{\contentsline {section}{\tocsection {}{4}{Approximation accuracy}}{4}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Per-token MAE (left) and signed bias (right) of the first-order surrogate $\genfrac  {}{}{}1{\alpha }{\Delta (1-\alpha )}\,\bigl  (\qopname  \relax o{log}T_n(y) - \qopname  \relax o{log}T_{n-\Delta }(y)\bigr  )$ against the exact $\qopname  \relax o{log}T_n(y) - \qopname  \relax o{log}E_n(y)$, averaged over masked tokens within each rollout. Both runs are no-centering EMA-reference cells; they differ only in which formula enters the loss (red: exact KL; blue: approx KL).}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:approx-error}{{4}{4}{Per-token MAE (left) and signed bias (right) of the first-order surrogate $\klapprox $ against the exact $\klexact $, averaged over masked tokens within each rollout. Both runs are no-centering EMA-reference cells; they differ only in which formula enters the loss (red: exact KL; blue: approx KL)}{figure.4}{}}
\@writefile{toc}{\contentsline {paragraph}{\tocparagraph {}{}{Across the $\alpha $-sweep.}}{4}{section*.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Per-token surrogate MAE across the $\alpha $-sweep. Left: intrinsic MAE (scales with $c_\alpha $). Right: MAE after rescaling to the $\alpha =0.9$ surrogate; comparable across $\alpha $ values.}}{4}{figure.5}\protected@file@percent }
\newlabel{fig:approx-error-alpha}{{5}{4}{Per-token surrogate MAE across the $\alpha $-sweep. Left: intrinsic MAE (scales with $c_\alpha $). Right: MAE after rescaling to the $\alpha =0.9$ surrogate; comparable across $\alpha $ values}{figure.5}{}}
