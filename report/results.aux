\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces $\alpha $ ablation on no-centering exact KL with $\beta $ scaled to keep $\beta \cdot c_\alpha $ constant. Higher $\alpha $ (slower EMA) becomes unstable: $\alpha =0.99$ collapses around step $\sim 200$, $\alpha =0.98$ partially collapses around step $\sim 300{-}400$; $\alpha \in \{0.8, 0.95\}$ match or beat the $\alpha =0.9$ baseline.}}{6}{figure.8}\protected@file@percent }
\newlabel{fig:ablation-alpha}{{8}{6}{$\alpha $ ablation on no-centering exact KL with $\beta $ scaled to keep $\beta \cdot c_\alpha $ constant. Higher $\alpha $ (slower EMA) becomes unstable: $\alpha =0.99$ collapses around step $\sim 200$, $\alpha =0.98$ partially collapses around step $\sim 300{-}400$; $\alpha \in \{0.8, 0.95\}$ match or beat the $\alpha =0.9$ baseline}{figure.8}{}}
\@writefile{toc}{\contentsline {section}{\tocsection {}{6}{Conclusion}}{6}{section.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces $\beta $ ablation on no-centering exact KL with IS off (B-noIS family).}}{7}{figure.9}\protected@file@percent }
\newlabel{fig:ablation-beta-nois}{{9}{7}{$\beta $ ablation on no-centering exact KL with IS off (B-noIS family)}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces $\beta $ ablation on the reset-reference $T/T$ cell (klMeanTrain). Larger $\beta $ prevents the late-run instability seen at $\beta =0.005$ (no collapse observed through step $\sim 580$ at $\beta =0.01$ or $\beta =0.05$).}}{7}{figure.10}\protected@file@percent }
\newlabel{fig:ablation-beta-reset}{{10}{7}{$\beta $ ablation on the reset-reference $T/T$ cell (klMeanTrain). Larger $\beta $ prevents the late-run instability seen at $\beta =0.005$ (no collapse observed through step $\sim 580$ at $\beta =0.01$ or $\beta =0.05$)}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces $\beta $ ablation on the reset-reference $I/I$ cell (klAllInf). The $\beta =0.01$ variant also uses the inference-snapshot reset fix.}}{8}{figure.11}\protected@file@percent }
\newlabel{fig:ablation-beta-reset-II}{{11}{8}{$\beta $ ablation on the reset-reference $I/I$ cell (klAllInf). The $\beta =0.01$ variant also uses the inference-snapshot reset fix}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces $\beta $ ablation on no-centering approx KL (cell D). Baseline $\beta =0.005$ vs.\ $\beta =0.05$ (10$\times $) and $\beta =0.0005$ (0.1$\times $). The cell is robust to weakening $\beta $ (no early-run impact at $\beta =0.0005$) but slower learning at $\beta =0.05$.}}{8}{figure.12}\protected@file@percent }
\newlabel{fig:ablation-beta-approx}{{12}{8}{$\beta $ ablation on no-centering approx KL (cell D). Baseline $\beta =0.005$ vs.\ $\beta =0.05$ (10$\times $) and $\beta =0.0005$ (0.1$\times $). The cell is robust to weakening $\beta $ (no early-run impact at $\beta =0.0005$) but slower learning at $\beta =0.05$}{figure.12}{}}
