\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Per-token MAE (left) and signed bias (right) of the first-order surrogate $\genfrac  {}{}{}1{\alpha }{\Delta (1-\alpha )}\,\bigl  (\qopname  \relax o{log}T_n(y) - \qopname  \relax o{log}T_{n-\Delta }(y)\bigr  )$ against the exact $\qopname  \relax o{log}T_n(y) - \qopname  \relax o{log}E_n(y)$, averaged over masked tokens within each rollout. Both runs are no-centering EMA-reference cells; they differ only in which formula enters the loss (red: exact KL; blue: approx KL).}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:approx-error}{{4}{4}{Per-token MAE (left) and signed bias (right) of the first-order surrogate $\klapprox $ against the exact $\klexact $, averaged over masked tokens within each rollout. Both runs are no-centering EMA-reference cells; they differ only in which formula enters the loss (red: exact KL; blue: approx KL)}{figure.4}{}}
