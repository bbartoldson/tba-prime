# Homogeneous reference run THROUGH the offsets mechanism (all ranks lag 10):
# controls for the reload-every-step machinery + vLLM logprob anchor, giving
# the (3)-arm the same code path as the heterogeneous arms. Equivalent
# regularization to the known-good noCenter cell (beta*c = 0.0045).
model="Qwen/Qwen3-4B-Instruct-2507"
LR=1e-6
sampled_k=16
train_k=16
async_level=10
steps=720
beta=0.005
type=tb
project=" --monitor.wandb.project fp4_KL "
conf=COUNTDOWN.toml
seq_length=4096
eval_steps=20
reference_mode=ema
ema_alpha=0.9
kl_approx=ema_first_order_use
kl_centering=false
vllm_logprobs=true
staleness_offsets=10,10,10,10
kl_approx_delta_source=per_rollout
