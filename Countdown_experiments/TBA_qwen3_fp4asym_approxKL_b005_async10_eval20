# Discovery arm (asymmetric): BF16 trainer, QDQ'd sampler only. The approx-KL
# penalty then contains the quantization gap -> soft-QAT hypothesis. Compare
# quantization-gap telemetry against the same run with beta=0.
model="Qwen/Qwen3-4B-Instruct-2507"
LR=1e-6
sampled_k=16
train_k=16
async_level=10
steps=720
beta=0.005
type=tb
project=" --monitor.wandb.project fp4_KL "
conf=COUNTDOWN.toml
seq_length=4096
eval_steps=20
reference_mode=ema
ema_alpha=0.9
kl_approx=ema_first_order_use
kl_centering=false
rollout_quant=nvfp4
vllm_logprobs=true
