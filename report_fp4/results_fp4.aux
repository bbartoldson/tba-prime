\newlabel{sec:fp4hetero}{{3.5}{6}{Does staleness weighting matter under FP4 heterogeneity?}{subsection.3.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The original-hypothesis cell: symmetric NVFP4 with heterogeneous staleness $\Delta _i \in \{1,4,10,32\}$. Yellow ($\beta {=}0$) collapses at ${\sim }$step 205 and never recovers; both KL arms --- per-rollout staleness-weighted $c_i$ (blue) and uniform $w{=}0.0045$ (aqua) --- train healthily through their full horizons and end within $0.007$ eval of each other.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:fp4hetero}{{5}{6}{The original-hypothesis cell: symmetric NVFP4 with heterogeneous staleness $\Delta _i \in \{1,4,10,32\}$. Yellow ($\beta {=}0$) collapses at ${\sim }$step 205 and never recovers; both KL arms --- per-rollout staleness-weighted $c_i$ (blue) and uniform $w{=}0.0045$ (aqua) --- train healthily through their full horizons and end within $0.007$ eval of each other}{figure.5}{}}
