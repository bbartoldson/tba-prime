\newlabel{sec:fp4}{{3.4}{4}{Does quantization compound with staleness?}{subsection.3.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces FP4 $\beta {=}0$ ladder and rescue arms. Blue/aqua: $\beta {=}0$ at $\Delta {=}10$ (stable) and $\Delta {=}32$ (collapses by step ${\sim }100$). Yellow/violet: the same theory dose $\beta c = 0.0045$ at $\Delta {=}10$ (stable through the full horizon) and $\Delta {=}32$ (holds ${\sim }3\times $ past the $\beta {=}0$ boundary, degrades late).}}{4}{figure.4}\protected@file@percent }
\newlabel{fig:fp4}{{4}{4}{FP4 $\beta {=}0$ ladder and rescue arms. Blue/aqua: $\beta {=}0$ at $\Delta {=}10$ (stable) and $\Delta {=}32$ (collapses by step ${\sim }100$). Yellow/violet: the same theory dose $\beta c = 0.0045$ at $\Delta {=}10$ (stable through the full horizon) and $\Delta {=}32$ (holds ${\sim }3\times $ past the $\beta {=}0$ boundary, degrades late)}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\tocsubsection {}{3.4}{Does quantization compound with staleness?}}{5}{figure.4}\protected@file@percent }
