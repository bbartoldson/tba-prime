\newlabel{sec:collapse}{{3.1}{2}{Does staleness alone break unregularized async RL?}{subsection.3.1}{}}
\@writefile{toc}{\contentsline {subsection}{\tocsubsection {}{3.1}{Does staleness alone break unregularized async RL?}}{2}{figure.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Collapse without the KL penalty; stability with it. Yellow (heterogeneous) and violet (homogeneous $\Delta {=}32$) are $\beta {=}0$: both collapse (steps ${\sim }230$ and ${\sim }170$) and never recover. Aqua (uniform dose $w{=}0.0045$) trains through the same window untouched; blue is the homogeneous $\Delta {=}10$ reference.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:collapse}{{1}{3}{Collapse without the KL penalty; stability with it. Yellow (heterogeneous) and violet (homogeneous $\Delta {=}32$) are $\beta {=}0$: both collapse (steps ${\sim }230$ and ${\sim }170$) and never recover. Aqua (uniform dose $w{=}0.0045$) trains through the same window untouched; blue is the homogeneous $\Delta {=}10$ reference}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces All stable arms. Calibrated per-rollout $c_i$ (aqua) vs.\ the two uniform doses (yellow $w{=}0.0045$, violet $w{=}0.015$) under the same $\Delta _i \in \{1,4,10,32\}$ mixture; blue is the homogeneous reference.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:dose}{{2}{3}{All stable arms. Calibrated per-rollout $c_i$ (aqua) vs.\ the two uniform doses (yellow $w{=}0.0045$, violet $w{=}0.015$) under the same $\Delta _i \in \{1,4,10,32\}$ mixture; blue is the homogeneous reference}{figure.2}{}}
